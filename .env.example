# Copy to .env.local and fill in.

# --- Required ---------------------------------------------------------------
# MongoDB connection string, including the database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/vpro
# Any long random string, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# The public address of the site. Used for payment redirects and link previews.
NEXTAUTH_URL=http://localhost:3000

# --- Payments (needed only to sell paid courses) -----------------------------
# Flutterwave dashboard → Settings → API keys.
FLUTTERWAVE_SECRET_KEY=
# Flutterwave dashboard → Settings → Webhooks: set the URL to
#   https://YOUR-DOMAIN/api/payments/webhook
# and choose a "secret hash". Put the same value here.
FLUTTERWAVE_SECRET_HASH=

# --- First admin account (optional, read once by `bun run init-db`) ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
